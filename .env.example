# use a .env.prod file when executing as production.

# Database access
# POSTGRES_PASSWORD=portal-dev-only     owner of the database, used by npm run db
# APP_DB_PASSWORD=summit-dev-only       the app's login (summit_app)
# DB_PORT=5432                          where it listens on this machine

# Plaid keys (the sandbox secret for testing)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_REDIRECT_URI=/plaid-oauth   set if redirect uri begins to matter

# Cloudflare tunnel's public address and token.
# WEB_ORIGIN=https://dev.example.com
# CLOUDFLARE_TUNNEL_TOKEN=