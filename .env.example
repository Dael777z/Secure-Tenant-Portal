DEV=1

PORT=3000
WEB_ORIGIN=http://localhost:5173
SECURE_COOKIES=0

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000000
BCRYPT_ROUNDS=12

SERVICE_NAME=portal
LOG_CONSOLE_ENABLED=1
LOG_FILE_ENABLED=1
LOG_FILE_PATH=logs/application.jsonl

# Postgres (Angel's schema in db/migrations). Leave empty with DEV=1 to use the
# in-memory store. `npm run db:up` starts a local Postgres matching this URL.
DATABASE_URL=postgres://portal:portal-dev-only@localhost:5432/portal
SEED_ADMIN_EMAIL=manager@example.com
SEED_ADMIN_PASSWORD=
# Integration tests create and drop tables here. Never point it at real data.
TEST_DATABASE_URL=postgres://portal:portal-dev-only@localhost:5432/portal_test

# Plaid (Dael's bank linking). Sandbox keys are in the team's Discord keys
# channel; never commit real values. Leave empty to record payments as demo
# transfers without bank linking.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Encrypts Plaid access tokens in the database (falls back to JWT_ACCESS_SECRET).
TOKEN_ENCRYPTION_KEY=
