# Optional development settings. Development works with no .env at all; copy this
# to .env only to change something. (Production settings live in .env.prod, which
# `npm run docker:prod` creates with random secrets the first time.)

# Development database (the portal-dev Postgres container).
# POSTGRES_PASSWORD=portal-dev-only     owner of the database, used by npm run db
# APP_DB_PASSWORD=summit-dev-only       the app's login (summit_app)
# DB_PORT=5432                          where it listens on this machine

# Plaid sandbox keys (team Discord; never commit them). Without them, paying from
# the tenant page records a test transfer.
# PLAID_CLIENT_ID=
# PLAID_SECRET=

# For npm run cloudflare:dev: the tunnel's public address and token.
# WEB_ORIGIN=https://dev.example.com
# CLOUDFLARE_TUNNEL_TOKEN=
