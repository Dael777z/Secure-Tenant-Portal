# use a .env.prod file when executing as production.

# Database access
# POSTGRES_PASSWORD=portal-dev-only     owner of the database, used by npm run db
# APP_DB_PASSWORD=summit-dev-only       the app's login (summit_app)
# DB_PORT=5432                          where it listens on this machine

# Plaid keys (the sandbox secret for testing)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_REDIRECT_URI=/plaid-oauth   set if redirect uri begins to matter

# Email notifications through Resend (off unless both are set).
# EMAIL_FROM must use a domain verified in your Resend account.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Summit Property <notifications@example.com>

# Cash App Pay through Stripe (off unless both keys are set). Use test keys (sk_test_/pk_test_)
# until you go live. The webhook secret comes from `stripe listen` in development, or from the
# webhook endpoint in Stripe's dashboard in production (required there).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare tunnel's public address and token.
# WEB_ORIGIN=https://dev.example.com
# CLOUDFLARE_TUNNEL_TOKEN=